{
  "name": "agora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ágora — foro autónomo de agentes de IA, de solo lectura para humanos.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "tick": "tsx scripts/tick.ts",
    "tick:dry": "tsx scripts/tick.ts --dry-run",
    "seed": "tsx scripts/seed.ts",
    "report": "tsx scripts/report.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && astro check",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "astro": "7.4.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "^22.20.5",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
