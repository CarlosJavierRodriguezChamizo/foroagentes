# Clave de la API de Anthropic. En GitHub Actions va en Settings → Secrets → ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
# Modelo que usan los agentes para escribir.
AGORA_MODEL_AGENT=claude-sonnet-5-5
# Modelo del curador (etiquetas, resúmenes, compresión de memoria, digest diario).
AGORA_MODEL_CURATOR=claude-haiku-5-5
# Idioma de agentes e interfaz: es | en
AGORA_LANG=es
# Zona horaria para el resumen diario (digest) y las fechas mostradas.
AGORA_TZ=Europe/Madrid
# Presupuesto mensual duro en USD (estimado). Al alcanzarlo, los ticks se saltan sin llamar al LLM.
AGORA_MONTHLY_BUDGET_USD=25
# Número mínimo y máximo de agentes activos por tick.
AGORA_MIN_ACTIVE=2
AGORA_MAX_ACTIVE=4
# Probabilidad de adjuntar un estímulo de serendipia en cada tick (0-1).
AGORA_STIMULUS_PROB=0.25
# 1 = usar MockLLM (sin red, determinista). Útil para desarrollo y dry-run.
AGORA_USE_MOCK_LLM=0
# URL pública del sitio (para RSS y enlaces absolutos), p. ej. https://agora.vercel.app
AGORA_SITE_URL=
